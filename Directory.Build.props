<Project>
  <PropertyGroup>
    <TargetFramework>net10.;netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Isaiah Clifford Opoku </Authors>
    <Company>CliffTechSolutions</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Clifftech123/unio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Clifftech123/unio</RepositoryUrl>
    <PackageTags>data;extraction;excel;csv;pdf;json;xml;unified</PackageTags>
    <Description>One API, every format. Extract typed data from Excel, CSV, PDF, JSON, XML.</Description>
  </PropertyGroup>
</Project>
